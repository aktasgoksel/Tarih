rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Öneriler: Giriş yapmış herkes yazabilir, sadece admin okuyabilir
    match /suggestions/{suggestionId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && request.auth.token.email == "gokselaktas84@gmail.com";
    }

    // Testler: Herkes okuyabilir, sadece admin yazabilir
    match /tests/{testId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "gokselaktas84@gmail.com";
    }

    // Kullanıcı verileri: Sadece kendi verilerini okuyabilir/yazabilir
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
