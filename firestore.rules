rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Öneriler: Giriş yapmış herkes yazabilir, sadece admin okuyabilir/silebilir
    match /suggestions/{suggestionId} {
      allow create: if request.auth != null 
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.text is string
                    && request.resource.data.text.size() < 5000;
      allow read, delete: if request.auth != null && request.auth.token.email == "gokselaktas84@gmail.com";
    }

    // Testler: Giriş yapmış herkes okuyabilir, sadece admin yazabilir
    match /tests/{testId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == "gokselaktas84@gmail.com";
    }

    // Kullanıcı verileri: Sadece kendi verilerini okuyabilir/yazabilir
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
